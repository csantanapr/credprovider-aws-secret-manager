{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ChainIntoTheAtespaceReader",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": "arn:REPLACE_WITH_AWS_PARTITION:iam::REPLACE_WITH_AWS_ACCOUNT_ID:role/ate-secrets-reader",
      "Condition": {
        "Null": {"aws:RequestTag/ate-atespace": "false"}
      }
    }
  ]
}
