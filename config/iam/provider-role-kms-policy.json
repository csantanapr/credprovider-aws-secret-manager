{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab",
      "Condition": {
        "StringEquals": {"kms:ViaService": "secretsmanager.us-west-2.amazonaws.com"}
      }
    }
  ]
}
