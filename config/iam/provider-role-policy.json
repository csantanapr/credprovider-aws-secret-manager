{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInjectableSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-west-2:111122223333:secret:ate/*",
      "Condition": {
        "StringEquals": {"aws:ResourceTag/ate.dev/injectable": "true"}
      }
    }
  ]
}
