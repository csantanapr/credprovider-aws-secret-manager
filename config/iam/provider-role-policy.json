{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInjectableSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:REPLACE_WITH_AWS_PARTITION:secretsmanager:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:secret:ate/*",
      "Condition": {
        "StringEquals": {"aws:ResourceTag/ate.dev/injectable": "true"}
      }
    }
  ]
}
