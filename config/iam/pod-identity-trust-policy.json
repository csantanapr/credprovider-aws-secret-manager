{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EksPodIdentityForThisClusterOnly",
      "Effect": "Allow",
      "Principal": {"Service": "pods.eks.amazonaws.com"},
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "REPLACE_WITH_AWS_ACCOUNT_ID",
          "aws:RequestTag/kubernetes-namespace": "ate-system",
          "aws:RequestTag/kubernetes-service-account": "aws-sm-credential-provider"
        },
        "ArnLike": {"aws:SourceArn": "arn:REPLACE_WITH_AWS_PARTITION:eks:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:cluster/REPLACE_WITH_EKS_CLUSTER_NAME"}
      }
    }
  ]
}
