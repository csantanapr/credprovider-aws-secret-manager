{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EksPodIdentityForThisClusterOnly",
      "Effect": "Allow",
      "Principal": {"Service": "pods.eks.amazonaws.com"},
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "111122223333"},
        "ArnLike": {"aws:SourceArn": "arn:aws:eks:us-west-2:111122223333:cluster/my-cluster"}
      }
    }
  ]
}
