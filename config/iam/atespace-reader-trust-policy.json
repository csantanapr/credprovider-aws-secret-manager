{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheProviderWithAnAtespaceTag",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:REPLACE_WITH_AWS_PARTITION:iam::REPLACE_WITH_AWS_ACCOUNT_ID:role/aws-sm-credential-provider"},
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "StringLike": {"aws:RequestTag/ate-atespace": "?*"},
        "Null": {"aws:RequestTag/ate-atespace": "false"}
      }
    }
  ]
}
